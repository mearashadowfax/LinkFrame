---
const heading = "Create a custom LinkedIn frame in seconds";
const subheading =
  "Stand out with personalized profile frames. Easily add text, colors, and symbols to showcase your skills, support causes, and more – all with real-time customization";
---

<header class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute start-1/2 -top-96 flex -translate-x-1/2 transform"
  >
    <div
      class="h-176 w-100 -translate-x-40 rotate-[-60deg] transform bg-linear-to-r from-violet-300/50 to-purple-100 blur-3xl"
    >
    </div>
    <div
      class="h-200 w-360 origin-top-left -translate-x-60 -rotate-12 rounded-full bg-linear-to-tl from-blue-50 via-blue-100 to-blue-50 blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative mx-auto max-w-5xl px-4 pt-20 pb-16 text-center sm:px-6 sm:pt-28 sm:pb-20 lg:px-8"
  >
    <div
      class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-border/80 bg-background/80 px-3 py-1.5 text-sm font-medium text-muted-foreground shadow-sm backdrop-blur corner-squircle"
    >
      Free, private, and processed in your browser
    </div>

    <h1
      class="font-heading text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl lg:leading-[1.05]"
    >
      {heading}
    </h1>

    <p
      class="mx-auto mt-6 max-w-3xl text-base leading-7 text-pretty text-muted-foreground sm:text-lg sm:leading-8"
    >
      {subheading}
    </p>

    <div class="mt-8 flex justify-center">
      <a
        href="#customizer"
        class="inline-flex h-10 items-center justify-center gap-2 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-all corner-squircle hover:bg-primary/85 focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
      >
        Create your frame
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </div>
</header>
