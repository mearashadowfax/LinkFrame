---
import Meta from "@common/Meta.astro";
import Hero from "@common/Hero.astro";
import ImageCustomizer from "@common/ImageCustomizer.astro";
import Footer from "@common/Footer.astro";
import { Font } from "astro:assets";
import { SITE } from "@data/constants";
import "@styles/global.css";

const { title = SITE.title, meta, structuredData } = Astro.props;

interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
}
---

<html lang="en" class="scrollbar-hide">
  <head>
    <Meta meta={meta} structuredData={structuredData} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-noto-sans" preload />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-background antialiased selection:bg-primary/15 selection:text-foreground"
  >
    <main class="relative">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_bottom,transparent_0%,oklch(0.97_0.025_240/.65)_45%,transparent_100%)]"
      >
      </div>
      <Hero />
      <ImageCustomizer />
    </main>
    <Footer />
  </body>
</html>
